#!/usr/bin/env bun

const USAGE = `greview - PR review in worktrees with Claude or Codex (/explain-diff-html)

Usage:
  greview [--codex] [github-url|graphite-url|pr-number|branch-name]

  Without args, lists PRs requesting your review (last 2 weeks) via fzf.
  With --codex, the review runs in the codex CLI instead of claude.

Examples:
  greview
  greview https://github.com/gamma-app/gamma/pull/4521
  greview https://app.graphite.com/github/pr/gamma-app/gamma/4521
  greview 4521
  greview jordan/my-feature
  greview --codex 4521

Note: run from the target repo directory. Worktree is cleaned up on exit.`;

const SKILL_PATH = `${process.env.HOME}/.claude/skills/explain-diff-html/SKILL.md`;

function parsePR(input: string): number | null {
  if (/^\d+$/.test(input)) return parseInt(input);

  // github.com/owner/repo/pull/123
  const gh = input.match(/github\.com\/[^/]+\/[^/]+\/pull\/(\d+)/);
  if (gh) return parseInt(gh[1]);

  // app.graphite.com/github/pr/owner/repo/123
  const gr = input.match(/graphite\.(?:com|dev)\/github\/pr\/[^/]+\/[^/]+\/(\d+)/);
  if (gr) return parseInt(gr[1]);

  return null;
}

async function prBranches(pr: number): Promise<{ branch: string; base: string }> {
  const proc = Bun.spawn(
    ["gh", "pr", "view", String(pr), "--json", "headRefName,baseRefName"],
    { stdout: "pipe", stderr: "pipe" }
  );
  const out = await new Response(proc.stdout).text();
  const code = await proc.exited;
  if (code !== 0) {
    console.error(`failed to resolve branch for PR #${pr}`);
    process.exit(1);
  }

  const parsed = JSON.parse(out) as { headRefName: string; baseRefName: string };

  return {
    branch: parsed.headRefName,
    base: parsed.baseRefName,
  };
}

async function pickPR(): Promise<number> {
  const twoWeeksAgo = new Date(Date.now() - 14 * 86400000).toISOString().slice(0, 10);
  const fields = "number,title,author,additions,deletions,reviewDecision,createdAt";
  const proc = Bun.spawn(
    ["gh", "pr", "list", "--search", `review-requested:@me created:>=${twoWeeksAgo}`, "--json", fields, "--limit", "50"],
    { stdout: "pipe", stderr: "pipe" }
  );
  const out = await new Response(proc.stdout).text();
  if ((await proc.exited) !== 0) {
    console.error("failed to fetch review-requested PRs");
    process.exit(1);
  }
  type PR = { number: number; title: string; author: { login: string }; additions: number; deletions: number; reviewDecision: string; createdAt: string };
  const prs = (JSON.parse(out) as PR[]).filter((p) => p.reviewDecision !== "APPROVED");
  if (!prs.length) {
    console.log("no PRs requesting your review in the last 2 weeks");
    process.exit(0);
  }

  const green = "\x1b[32m";
  const red = "\x1b[31m";
  const gray = "\x1b[90m";
  const reset = "\x1b[0m";
  const dim = "\x1b[2m";
  const pad = (s: string, n: number) => s.length > n ? s.slice(0, n) : s.padEnd(n);
  const relTime = (iso: string) => {
    const ms = Date.now() - new Date(iso).getTime();
    const m = Math.floor(ms / 60000);
    if (m < 60) return `${m}m`;
    const h = Math.floor(m / 60);
    if (h < 24) return `${h}h`;
    return `${Math.floor(h / 24)}d`;
  };
  const sp = "   ";
  const header = `${"PR#".padEnd(7)}${sp}${pad("Author", 12)}${sp}${"Title".padEnd(60)}${sp}${"Age".padEnd(5)}${sp}+/-`;
  const lines = prs.map((p) => {
    const num = String(p.number).padEnd(7);
    const author = pad(p.author.login, 12);
    const title = pad(p.title, 60);
    const age = `${gray}${pad(relTime(p.createdAt), 5)}${reset}`;
    const adds = `${green}+${p.additions}${reset}`;
    const dels = `${red}-${p.deletions}${reset}`;
    return `${p.number}\t${dim}${num}${reset}${sp}${author}${sp}${title}${sp}${age}${sp}${adds}${dim}/${reset}${dels}`;
  }).join("\n");
  const fzf = Bun.spawn(
    ["fzf", "--header", header, "--with-nth", "2..", "--delimiter", "\t", "--ansi", "--reverse"],
    { stdin: "pipe", stdout: "pipe", stderr: "inherit" }
  );
  fzf.stdin.write(lines);
  fzf.stdin.end();
  const selected = (await new Response(fzf.stdout).text()).trim();
  if ((await fzf.exited) !== 0 || !selected) {
    process.exit(1);
  }
  return parseInt(selected.split("\t")[0]);
}

// codex has no skill system, so the /explain-diff-html instructions are inlined
// into its prompt. Read them at runtime so both agents stay on the same source.
async function readSkillBody(): Promise<string> {
  try {
    const raw = await Bun.file(SKILL_PATH).text();
    const withoutFrontmatter = raw.replace(/^---\n[\s\S]*?\n---\n/, "");

    return withoutFrontmatter.trim();
  } catch (error) {
    console.error(`could not read skill at ${SKILL_PATH}`, error);
    process.exit(1);
  }
}

async function hasCommand(name: string): Promise<boolean> {
  const proc = Bun.spawn(["which", name], { stdout: "ignore", stderr: "ignore" });

  return (await proc.exited) === 0;
}

const args = process.argv.slice(2);
if (args.includes("--help") || args.includes("-h")) {
  console.log(USAGE);
  process.exit(0);
}

const useCodex = args.includes("--codex");
const input = args.find((arg) => !arg.startsWith("-"));

if (useCodex && !(await hasCommand("codex"))) {
  console.error("codex CLI not found on PATH — install it or drop --codex");
  process.exit(1);
}

if (!process.cwd().startsWith("/Users/jordan/code/gamma")) {
  process.chdir("/Users/jordan/code/gamma");
}

let pr: number;
if (!input) {
  pr = await pickPR();
} else {
  const parsed = parsePR(input);
  if (parsed) {
    pr = parsed;
  } else {
    const lookup = Bun.spawn(
      ["gh", "pr", "list", "--head", input, "--json", "number", "-q", ".[0].number"],
      { stdout: "pipe", stderr: "pipe" }
    );
    const out = await new Response(lookup.stdout).text();
    const code = await lookup.exited;
    const num = parseInt(out.trim());
    if (code !== 0 || isNaN(num)) {
      console.error(`no PR found for branch: ${input}`);
      process.exit(1);
    }
    pr = num;
  }
}

// resolve branches before building the prompt (base is referenced in it)
// and before launching so we can clean up after
const { branch, base } = await prBranches(pr);

const context = [
  `The PR branch (${branch}) is already checked out locally — your cwd is a worktree at its HEAD.`,
  `Get the diff locally with \`git diff origin/${base}...HEAD\`, and read/explore any file in the repo directly for surrounding context.`,
  `\`gh pr view ${pr} --json title,body,url\` has the PR title and description.`,
  `Do NOT edit or commit any code. This is read-only.`,
  `When the HTML file is written, open it in the browser with \`open <path>\`.`,
];

// claude: a leading slash command invokes the explain-diff-html skill, and
// everything after it is the "specified code change" context.
// codex: the same skill text is inlined, because codex cannot resolve the command.
const prompt = useCodex
  ? [await readSkillBody(), ``, `The code change is PR #${pr}.`, ...context].join("\n")
  : [`/explain-diff-html PR #${pr}`, ``, ...context].join("\n");

// switch to worktree (creates if needed), but don't exec into it
const sw = Bun.spawn(["wt", "switch", `pr:${pr}`, "--no-cd"], {
  stdio: ["inherit", "inherit", "inherit"],
});
await sw.exited;

// resolve worktree path
const pathProc = Bun.spawn(
  ["git", "worktree", "list", "--porcelain"],
  { stdout: "pipe", stderr: "pipe" }
);
const wtOutput = await new Response(pathProc.stdout).text();
await pathProc.exited;

let worktreePath: string | null = null;
const blocks = wtOutput.split("\n\n");
for (const block of blocks) {
  if (block.includes(`branch refs/heads/${branch}`)) {
    const match = block.match(/^worktree (.+)$/m);
    if (match) worktreePath = match[1];
  }
}
if (!worktreePath) {
  console.error(`could not find worktree path for branch: ${branch}`);
  process.exit(1);
}

// pull latest from remote so the worktree is up to date
const pull = Bun.spawn(["git", "-C", worktreePath, "pull", "--ff-only"], {
  stdio: ["inherit", "inherit", "inherit"],
});
await pull.exited;

// launch the agent in the worktree, both in their no-prompt / no-sandbox mode
const command = useCodex
  ? ["codex", "--dangerously-bypass-approvals-and-sandbox", prompt]
  : ["claude", "--dangerously-skip-permissions", prompt];

const proc = Bun.spawn(command, {
  stdio: ["inherit", "inherit", "inherit"],
  cwd: worktreePath,
});
await proc.exited;

// cleanup worktree after the agent exits
const rm = Bun.spawn(["wt", "remove", "-D", branch], {
  stdio: ["inherit", "inherit", "inherit"],
});
await rm.exited;
